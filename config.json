{
  "version": "b0.0.1",

  "discord": {
    "guild_id": 1081683604066812004,
    "channel_id": 1550492435182780597,
    "admin_role_id": 1102655088717205565,
    "restrict_to_channel": true,
    "allow_server_administrators": true
  },

  "ansible": {
    "workdir": "/root/infra",
    "playbook_cmd": "ansible-playbook",
    "adhoc_cmd": "ansible",
    "default_timeout": 3600,
    "log_dir": "logs",
    "log_retention_days": 30,
    "allow_exec": false,
    "env": {
      "ANSIBLE_FORCE_COLOR": "0",
      "ANSIBLE_NOCOLOR": "1",
      "ANSIBLE_STDOUT_CALLBACK": "default",
      "PYTHONUNBUFFERED": "1"
    }
  },

  "panel": {
    "title": "Ansible — Panneau de contrôle",
    "description": "Gestion du parc de VM depuis Discord.\nChaque action est journalisée et le log complet est joint en fin d'exécution.",
    "color": "5865F2",
    "show_action_list": true,
    "footer_note": "Ansible Control"
  },

  "actions": [
    {
      "id": "ping",
      "label": "Ping",
      "emoji": "\ud83d\udce1",
      "style": "secondary",
      "row": 0,
      "description": "Teste la connexion SSH vers tous les hôtes.",
      "type": "adhoc",
      "pattern": "all",
      "module": "ping",
      "become": false,
      "confirm": false,
      "timeout": 120,
      "button": true
    },
    {
      "id": "disk",
      "label": "Disques",
      "emoji": "\ud83d\udcbe",
      "style": "secondary",
      "row": 0,
      "description": "Espace disque restant sur chaque hôte.",
      "type": "adhoc",
      "pattern": "all",
      "module": "shell",
      "args": "df -h / /var 2>/dev/null | tail -n +1",
      "become": true,
      "confirm": false,
      "timeout": 120,
      "button": true
    },
    {
      "id": "uptime",
      "label": "Uptime",
      "emoji": "\u23f1\ufe0f",
      "style": "secondary",
      "row": 0,
      "description": "Uptime et charge de chaque hôte.",
      "type": "adhoc",
      "pattern": "all",
      "module": "command",
      "args": "uptime",
      "become": false,
      "confirm": false,
      "timeout": 120,
      "button": true
    },
    {
      "id": "pending",
      "label": "Reboot requis ?",
      "emoji": "\u2753",
      "style": "secondary",
      "row": 0,
      "description": "Liste les hôtes en attente de redémarrage.",
      "type": "adhoc",
      "pattern": "all",
      "module": "shell",
      "args": "test -f /var/run/reboot-required && echo 'REDEMARRAGE REQUIS' || echo 'ok'",
      "become": true,
      "confirm": false,
      "timeout": 120,
      "button": true
    },

    {
      "id": "dryrun",
      "label": "Simulation",
      "emoji": "\ud83e\uddea",
      "style": "secondary",
      "row": 1,
      "description": "Mise à jour en mode --check, ne modifie rien.",
      "type": "playbook",
      "playbook": "update.yml",
      "check": true,
      "confirm": false,
      "timeout": 1800,
      "button": true
    },
    {
      "id": "update",
      "label": "Mettre à jour",
      "emoji": "\ud83d\udce6",
      "style": "primary",
      "row": 1,
      "description": "Met à jour les 5 VM, sans redémarrer.",
      "type": "playbook",
      "playbook": "update.yml",
      "confirm": false,
      "timeout": 3600,
      "button": true
    },
    {
      "id": "maintenance",
      "label": "Update + reboot main",
      "emoji": "\ud83d\udd04",
      "style": "primary",
      "row": 1,
      "description": "Met à jour tout, puis redémarre les `main` qui en ont besoin. Le webserver n'est pas redémarré.",
      "type": "playbook",
      "playbook": "maintenance.yml",
      "confirm": true,
      "timeout": 5400,
      "button": true
    },

    {
      "id": "reboot_main",
      "label": "Reboot main",
      "emoji": "\ud83d\udd01",
      "style": "danger",
      "row": 2,
      "description": "Redémarre les serveurs `main` un par un, sans mise à jour.",
      "type": "playbook",
      "playbook": "reboot.yml",
      "extra_vars": { "seulement_si_requis": false },
      "confirm": true,
      "timeout": 3600,
      "button": true
    },
    {
      "id": "maintenance_full",
      "label": "Update + reboot TOUT",
      "emoji": "\u26a0\ufe0f",
      "style": "danger",
      "row": 2,
      "description": "Comme ci-dessus mais redémarre aussi le **webserver** (coupure du reverse proxy).",
      "type": "playbook",
      "playbook": "maintenance.yml",
      "extra_vars": { "reboot_critical": true },
      "confirm": true,
      "confirm_text": "Le webserver (nginx) sera redémarré : tous tes services web seront coupés pendant environ une minute.",
      "timeout": 5400,
      "button": true
    },
    {
      "id": "reboot_critical",
      "label": "Reboot webserver",
      "emoji": "\ud83d\udea8",
      "style": "danger",
      "row": 2,
      "description": "Redémarre uniquement le serveur critique.",
      "type": "adhoc",
      "pattern": "critical",
      "module": "reboot",
      "become": true,
      "confirm": true,
      "confirm_text": "Coupure du reverse proxy nginx pendant le redémarrage.",
      "timeout": 900,
      "button": true
    },

    {
      "id": "nginx_test",
      "label": "Test nginx",
      "emoji": "\ud83e\uddf0",
      "style": "success",
      "row": 3,
      "description": "Valide la configuration nginx du serveur critique.",
      "type": "adhoc",
      "pattern": "critical",
      "module": "command",
      "args": "nginx -t",
      "become": true,
      "confirm": false,
      "timeout": 120,
      "button": true
    },
    {
      "id": "nginx_reload",
      "label": "Reload nginx",
      "emoji": "\u267b\ufe0f",
      "style": "success",
      "row": 3,
      "description": "Recharge nginx sans coupure (test de conf automatique avant).",
      "type": "adhoc",
      "pattern": "critical",
      "module": "shell",
      "args": "nginx -t && systemctl reload nginx && echo reloaded",
      "become": true,
      "confirm": true,
      "timeout": 120,
      "button": true
    },
    {
      "id": "docker_ps",
      "label": "Conteneurs",
      "emoji": "\ud83d\udc33",
      "style": "success",
      "row": 3,
      "description": "Conteneurs Docker non sains ou arrêtés.",
      "type": "adhoc",
      "pattern": "all",
      "module": "shell",
      "args": "command -v docker >/dev/null || { echo 'docker absent'; exit 0; }; docker ps -a --filter status=exited --filter status=restarting | tail -n +2 | head -20 | awk '{print $1, $NF}'; echo '--- total:' $(docker ps -q | wc -l) 'en cours'",
      "become": true,
      "confirm": false,
      "timeout": 180,
      "button": true
    },
    {
      "id": "services",
      "label": "Services KO",
      "emoji": "\ud83e\ude7a",
      "style": "success",
      "row": 3,
      "description": "Unités systemd en échec sur chaque hôte.",
      "type": "adhoc",
      "pattern": "all",
      "module": "shell",
      "args": "systemctl list-units --state=failed --no-legend --no-pager | head -20 || true",
      "become": true,
      "confirm": false,
      "timeout": 180,
      "button": true
    }
  ]
}
